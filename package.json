{
  "name": "lyric-overlay",
  "version": "1.0.0",
  "description": "Spotify Lyrics Overlay",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },

  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.0"
  },

  "build": {
    "appId": "com.kunaldangi.lyricoverlay",
    "productName": "Lyrics Overlay",

    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.music"
    },

    "dmg": {
      "title": "Lyrics Overlay",
      "iconSize": 100
    }
  }
}
